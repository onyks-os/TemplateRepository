# Variables injected by the bootstrap for the "generic" profile.
# Use this profile for polyglot repositories, or for a language with no dedicated
# profile yet. Fill in make/generic.mk to wire your toolchain to the contract.
PRIMARY_LANGUAGE="Shell"
PRIMARY_LANGUAGE_LOGO="gnubash"
MIN_LANG_VERSION="5.0"
CODEQL_LANGUAGE="actions"
DEPENDABOT_ECOSYSTEM="github-actions"
LINTER_NAME="ShellCheck"
PKG_DIR_PLACEHOLDER=""

# See template/python/profile.env for what SKELETON_PATHS controls.
# The generic profile ships no source skeleton.
SKELETON_PATHS=""
