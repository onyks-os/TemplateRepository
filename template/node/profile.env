# Variables injected by the bootstrap for the "node" profile.
PRIMARY_LANGUAGE="TypeScript"
PRIMARY_LANGUAGE_LOGO="typescript"
MIN_LANG_VERSION="20"
CODEQL_LANGUAGE="javascript-typescript"
DEPENDABOT_ECOSYSTEM="npm"
LINTER_NAME="ESLint"
PKG_DIR_PLACEHOLDER=""

# See template/python/profile.env for what SKELETON_PATHS controls.
SKELETON_PATHS="src tests"
