# Variables injected by the bootstrap for the "python" profile.
PRIMARY_LANGUAGE="Python"
PRIMARY_LANGUAGE_LOGO="python"
MIN_LANG_VERSION="3.10"
CODEQL_LANGUAGE="python"
DEPENDABOT_ECOSYSTEM="pip"
LINTER_NAME="Ruff"
PKG_DIR_PLACEHOLDER="__PKG__"

# The runnable example: source skeleton plus the tests written against it.
# Skipped as a unit when the target already has its own source of the same name,
# so a scaffolded test can never reference a skeleton that was not written.
SKELETON_PATHS="__PKG__ tests fuzzing"
